# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ADS PROVIDER
# auto tries the SearchAPI key pool, then direct Meta, then Foreplay.
ADS_PROVIDER=auto
# Legacy single-key configuration remains supported.
SEARCH_API_KEY=
# Recommended production key pool. Invalid, exhausted, or temporarily unavailable
# keys automatically fail over to the next configured key.
SEARCH_API_KEY_1=
SEARCH_API_KEY_2=
SEARCH_API_KEY_3=
SEARCH_API_KEY_4=
# Alternative: comma- or whitespace-separated keys in one secret.
SEARCH_API_KEYS=

# Optional Foreplay Public API. Server-only; never prefix with NEXT_PUBLIC_.
FOREPLAY_API_KEY=

# Stored as Supabase Edge Function secrets in production
META_APP_ID=
META_APP_SECRET=
META_AD_LIBRARY_ACCESS_TOKEN=

# Provider configuration
META_AD_LIBRARY_ENABLED=
META_API_VERSION=
META_DEFAULT_COUNTRY=
META_API_TIMEOUT_MS=

# Optional Google Programmable Search / Custom Search JSON API enrichment.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Media archival is opt-in. Enable only when your provider/platform rights permit copying.
ALLOW_MEDIA_ARCHIVAL=false

# Local dashboard preview. Never enable in a deployed production environment.
DEV_BYPASS_AUTH=false

# TEMPORARY: Enable password login for payment review
ENABLE_PAYMENT_REVIEWER_LOGIN=false
PAYMENT_REVIEWER_EMAIL=saiyanadvertising@gmail.com

